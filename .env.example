# Sarvam AI reads the filing PDFs (sarvam-105b + Document Intelligence OCR)
SARVAM_API_KEY=

# devnet now; mainnet-beta later (switches the fill path to Jupiter)
NEXT_PUBLIC_CLUSTER=devnet
# Helius devnet RPC, e.g. https://devnet.helius-rpc.com/?api-key=...  (blank = public devnet RPC)
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=

# Agent keypair (Solana CLI JSON format). Generated locally; never commit.
AGENT_KEYPAIR_PATH=keys/agent.json

# SEC requires a descriptive User-Agent with contact email
SEC_USER_AGENT="Coattails you@example.com"

DATABASE_URL=file:./data/coattails.db

# Public URL used in Blinks and share links
NEXT_PUBLIC_SITE_URL=https://coattails.adilhusain.xyz

# Optional: Pyth price data (Hermes + Benchmarks). Free trial at https://pythdata.app/signup
PYTH_API_KEY=
# Optional: Jupiter API key (higher rate limit). https://developers.jup.ag/portal
JUPITER_API_KEY=

# Agent token launch (mainnet, scripts/launch/*). Launch wallet: keys/launch.json
CLAWPUMP_API_KEY=
# Mainnet RPC for the launch scripts (blank = public mainnet RPC)
MAINNET_RPC_URL=

# PTR reader: GPT-6 Luna via OpenRouter (falls back to Sarvam when blank)
OPENROUTER_API_KEY=

# Equity feeds your Pyth plan grants (Demo trial: TSLA,QQQ,VOO). Blank = try every ticker.
PYTH_EQUITY_TICKERS=
